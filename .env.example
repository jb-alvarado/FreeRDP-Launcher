# Optional local overrides. Existing environment variables take precedence.
# Defaults come from build-config.json; uncomment only to override.
# FREERDP_REPOSITORY=https://github.com/FreeRDP/FreeRDP.git
# FREERDP_BRANCH=master
# Empty means resolve the selected branch at build time; releases record its exact commit.
# FREERDP_COMMIT=
# Example: use the integration fork with the macOS SDL3 fixes.
# FREERDP_REPOSITORY=https://github.com/jb-alvarado/FreeRDP.git
# FREERDP_BRANCH=integration/sdl3-macos-fixes
# FREERDP_COMMIT=
# Optional clean local checkout instead of downloading FreeRDP:
# FREERDP_SOURCE=../FreeRDP
# Native architecture only: arm64 or x86_64.
# ARCH=arm64
# JOBS=8
# MACOSX_DEPLOYMENT_TARGET=13.0
# Optional: omit FFmpeg, with reduced audio/scaling support and native VideoToolbox.
# WITH_FFMPEG=OFF
